{
  "name": "research-paper-pipeline",
  "version": "0.1.0",
  "description": "Machine-checkable gates for a research paper kept in git: ESLint rules over .tex/.md paper sources, plus the skills and hooks that drive each stage.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "vigiles test --min=1",
    "lint": "eslint .",
    "lint:skills": "vigiles lint",
    "check:globs": "node scripts/rules-see-files.mjs",
    "check:content-only": "node scripts/rules-are-content-only.mjs",
    "check:readme": "node scripts/readme-numbers.mjs",
    "test:sabotage": "node scripts/run-mutations.mjs"
  },
  "dependencies": {
    "@eslint/plugin-kit": "^0.7.2",
    "@retorquere/bibtex-parser": "^10.0.1",
    "@unified-latex/unified-latex-util-parse": "^1.8.4",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/markdown": "^8.0.3",
    "eslint": "^10.9.1",
    "vigiles": "^27.2.0"
  },
  "peerDependencies": {
    "vigiles": "^27.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zernie/research-paper-pipeline.git"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "latex",
    "tex",
    "research",
    "paper",
    "academic",
    "linter",
    "claude-code"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "research-paper-pipeline": "bin/rpp.mjs",
    "rpp": "bin/rpp.mjs"
  }
}
