{
  "name": "paperlint",
  "version": "0.0.0-semantically-released",
  "description": "A linter for scientific papers written in LaTeX: catches mistakes before you submit to a conference or journal.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.pkg.json && tsc",
    "prepare": "tsc -p tsconfig.pkg.json && tsc",
    "test": "node scripts/test.ts",
    "test:e2e": "vitest run --project 'e2e-*'",
    "test:e2e:install": "vitest run --project e2e-install",
    "test:e2e:tex": "vitest run --project e2e-tex",
    "coverage": "NODE_OPTIONS=\"--import=./test/coverage-src.ts $NODE_OPTIONS\" c8 --check-coverage npm test --",
    "lint": "eslint .",
    "check": "node scripts/check.ts",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check ."
  },
  "dependencies": {
    "@eslint/markdown": "^8.0.3",
    "@eslint/plugin-kit": "^0.7.2",
    "@unified-latex/unified-latex-types": "^1.8.4",
    "@unified-latex/unified-latex-util-parse": "^1.8.4",
    "@unified-latex/unified-latex-util-visit": "^1.8.4",
    "ajv": "^6.12.6",
    "eslint": "^10.9.1",
    "js-yaml": "^4.1.0",
    "markdown-it": "^14.3.0",
    "mp4box": "^2.4.1",
    "remeda": "^2.50.0",
    "srt-parser-2": "^1.2.3",
    "ts-essentials": "^10.2.1",
    "typescript": "^6.0.3",
    "unpdf": "^1.8.1",
    "vigiles": "^31.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@retorquere/bibtex-parser": "^10.0.1",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.1",
    "c8": "^12.0.0",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-sonarjs": "^4.2.1",
    "prettier": "^3.8.1",
    "semantic-release": "25.0.9",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@retorquere/bibtex-parser": "^10.0.1"
  },
  "peerDependenciesMeta": {
    "@retorquere/bibtex-parser": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zernie/paperlint.git"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "latex",
    "tex",
    "research",
    "paper",
    "academic",
    "linter",
    "claude-code"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "paperlint": "bin/paperlint.mjs"
  },
  "exports": {
    "./eslint-rules/*.mjs": {
      "types": "./dist/eslint-rules/*.d.ts",
      "default": "./dist/eslint-rules/*.js"
    },
    "./lib/skill-checks.mjs": "./lib/skill-checks.mjs",
    "./lib/skill-corpus.mjs": "./lib/skill-corpus.mjs",
    "./lib/skill-eval-kit.mjs": "./lib/skill-eval-kit.mjs",
    "./lib/skill-trigger-cases.mjs": "./lib/skill-trigger-cases.mjs",
    "./lib/trigger-ledger.mjs": "./lib/trigger-ledger.mjs",
    "./lib/*.mjs": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "./*": "./*"
  },
  "files": [
    ".github",
    "CLAUDE.md",
    "CONTRIBUTING.md",
    "action.harness.mjs",
    "action.yml",
    "bin",
    "dist",
    "docs",
    "eslint-rules",
    "eslint.config.mjs",
    "fixtures",
    "!fixtures/accepted-papers",
    "!fixtures/real-markdown-paper",
    "fixtures/real-markdown-paper/baseline.*",
    "hooks",
    "lib",
    "presets",
    "plugin",
    "scripts",
    "skills",
    "src",
    "templates",
    "tsconfig.json",
    "tsconfig.pkg.json"
  ],
  "imports": {
    "#lib/*": {
      "paperlint-source": "./lib/*.ts",
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "#eslint-rules/*": {
      "paperlint-source": "./eslint-rules/*.ts",
      "types": "./dist/eslint-rules/*.d.ts",
      "default": "./dist/eslint-rules/*.js"
    }
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
