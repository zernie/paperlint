{
  "name": "research-paper-pipeline",
  "version": "0.0.0-semantically-released",
  "description": "Machine-checkable gates for a research paper kept in git: ESLint rules over .tex/.md paper sources, plus the skills and hooks that drive each stage.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "node scripts/exclusive.mjs vitest run && node scripts/exclusive.mjs vigiles test --min=1",
    "lint": "node scripts/exclusive.mjs eslint .",
    "check": "node scripts/check.mjs",
    "test:e2e": "node scripts/exclusive.mjs node test/e2e/install.mjs && node scripts/exclusive.mjs node test/e2e/build.mjs",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check ."
  },
  "dependencies": {
    "@eslint/markdown": "^8.0.3",
    "@eslint/plugin-kit": "^0.7.2",
    "@unified-latex/unified-latex-util-parse": "^1.8.4",
    "ajv": "^8.20.0",
    "eslint": "^10.9.1",
    "js-yaml": "^5.4.2",
    "markdown-it": "^15.0.2",
    "ts-essentials": "^10.2.1",
    "typescript": "^7.0.2",
    "unpdf": "^1.8.1",
    "vigiles": "^31.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@retorquere/bibtex-parser": "^11.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "^26.6.1",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-n": "^18.3.0",
    "prettier": "^3.8.1",
    "semantic-release": "25.0.9",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "@retorquere/bibtex-parser": "^11.0.0"
  },
  "peerDependenciesMeta": {
    "@retorquere/bibtex-parser": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zernie/research-paper-pipeline.git"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "latex",
    "tex",
    "research",
    "paper",
    "academic",
    "linter",
    "claude-code"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "research-paper-pipeline": "bin/rpp.mjs",
    "rpp": "bin/rpp.mjs"
  },
  "files": [
    ".claude-plugin",
    ".github",
    "CLAUDE.md",
    "CONTRIBUTING.md",
    "action.harness.mjs",
    "action.mutations.mjs",
    "action.yml",
    "bin",
    "dist",
    "docs",
    "eslint-rules",
    "eslint.config.mjs",
    "fixtures",
    "!fixtures/real-markdown-paper",
    "fixtures/real-markdown-paper/baseline.*",
    "hooks",
    "lib",
    "plugin",
    "scripts",
    "skills",
    "src",
    "templates",
    "tsconfig.json"
  ]
}
