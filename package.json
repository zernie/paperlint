{
  "name": "research-paper-pipeline",
  "version": "0.0.0",
  "private": true,
  "description": "Machine-checkable gates for writing a research paper in git",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "vigiles test --min=1",
    "lint": "eslint .",
    "lint:skills": "vigiles lint",
    "check:globs": "node scripts/rules-see-files.mjs",
    "check:content-only": "node scripts/rules-are-content-only.mjs",
    "test:mutations": "node scripts/run-mutations.mjs"
  },
  "dependencies": {
    "@eslint/plugin-kit": "^0.7.2",
    "@retorquere/bibtex-parser": "^11.0.0",
    "@unified-latex/unified-latex-util-parse": "^1.8.4",
    "js-yaml": "^5.4.2"
  },
  "devDependencies": {
    "@eslint/markdown": "^8.0.3",
    "eslint": "^10.9.1",
    "vigiles": "^27.2.0"
  },
  "peerDependencies": {
    "vigiles": "^27.2.0"
  }
}
