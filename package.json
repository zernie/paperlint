{
  "name": "research-paper-pipeline",
  "version": "0.1.0",
  "description": "Machine-checkable gates for a research paper kept in git: ESLint rules over .tex/.md paper sources, plus the skills and hooks that drive each stage.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "node scripts/exclusive.mjs vigiles test --min=1",
    "lint": "node scripts/exclusive.mjs eslint .",
    "lint:skills": "node scripts/exclusive.mjs vigiles lint . README.md",
    "check:globs": "node scripts/exclusive.mjs node scripts/rules-see-files.mjs",
    "check:content-only": "node scripts/exclusive.mjs node scripts/rules-are-content-only.mjs",
    "check:readme": "node scripts/exclusive.mjs node scripts/readme-numbers.mjs",
    "test:sabotage": "node scripts/exclusive.mjs node scripts/run-mutations.mjs",
    "test:install": "node scripts/exclusive.mjs node test/e2e/install.mjs",
    "test:build": "node scripts/exclusive.mjs node test/e2e/build.mjs",
    "check:marketplace": "node scripts/exclusive.mjs node scripts/marketplace-shape.mjs",
    "check": "node scripts/check.mjs",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check ."
  },
  "dependencies": {
    "@eslint/markdown": "^8.0.3",
    "@eslint/plugin-kit": "^0.7.2",
    "@unified-latex/unified-latex-util-parse": "^1.8.4",
    "eslint": "^10.9.1",
    "js-yaml": "^4.1.0",
    "markdown-it": "^14.3.0",
    "vigiles": "^31.0.1"
  },
  "devDependencies": {
    "@retorquere/bibtex-parser": "^10.0.1",
    "@types/node": "^26.6.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@retorquere/bibtex-parser": "^10.0.1"
  },
  "peerDependenciesMeta": {
    "@retorquere/bibtex-parser": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zernie/research-paper-pipeline.git"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "latex",
    "tex",
    "research",
    "paper",
    "academic",
    "linter",
    "claude-code"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "research-paper-pipeline": "bin/rpp.mjs",
    "rpp": "bin/rpp.mjs"
  },
  "files": [
    ".claude-plugin",
    ".github",
    "CLAUDE.md",
    "CONTRIBUTING.md",
    "action.harness.mjs",
    "action.mutations.mjs",
    "action.yml",
    "bin",
    "dist",
    "docs",
    "eslint-rules",
    "eslint.config.mjs",
    "fixtures",
    "!fixtures/real-markdown-paper",
    "fixtures/real-markdown-paper/baseline.*",
    "hooks",
    "lib",
    "plugin",
    "scripts",
    "skills",
    "src",
    "templates",
    "tsconfig.json"
  ]
}
