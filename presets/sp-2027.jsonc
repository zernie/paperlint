// IEEE S&P 2027 (the 48th IEEE Symposium on Security and Privacy, "Oakland"), research papers and
// SoK papers — a VENUE preset over the IEEE conference family. Everything the IEEEtran template
// decides (page size, columns, fonts, body size, TeX packages) comes from ieee-conference.jsonc;
// this file adds what S&P's call for papers sets.
//
// Verbatim from https://sp2027.ieee-security.org/cfpapers.html (fetched 2026-11-19):
//   «Submitted papers may include up to 13 pages of text and up to 5 pages for references and
//    appendices, totaling no more than 18 pages. All text and figures past page 13 must be clearly
//    marked as part of the appendix. The final camera-ready paper must be no more than 18 pages,
//    although, at the PC chairs' discretion, additional pages may be allowed. Reviewers are not
//    required to read appendices. For SoK papers, the references do not count towards the number
//    of pages.»
//   «Papers that are over the allowed number of pages will be rejected without review.»
//   «Papers must be formatted for US letter (not A4) size paper. All submissions must use the IEEE
//    "compsoc" conference proceedings template. LaTeX submissions using the IEEE templates must use
//    IEEEtran.cls version 1.8b with options "conference,compsoc." (That is, begin your LaTeX
//    document with the line \documentclass[conference,compsoc]{IEEEtran}.)»
//   «Papers must be submitted in a form suitable for anonymous review: no author names or
//    affiliations (whether they are real or the default fake names included in the IEEE template)
//    may appear on the title page, and papers should avoid revealing authors' identity in the
//    text.»
//   «All deadlines are 23:59:59 AoE (UTC-12).»
//
// 🔴 TWO SUBMISSION CYCLES, TWO PORTALS. The call: «First deadline: https://cycle1.sp2027.ieee-security.org/»
// and «Second deadline: https://cycle2.sp2027.ieee-security.org». A preset holds one portal and one
// reading of each deadline, so it carries the SECOND cycle, the later one; the first cycle's dates,
// with their quotes and the portal's readings, are in the card (sp.md beside this file). Both
// cycles' paper deadlines had passed on the day this was read (cycle 2: 2026-11-17 AoE); no S&P
// 2028 call was found that day (a web search found none, and sp2028.ieee-security.org could not be
// reached).
//
// Its card, in prose: `sp.md` beside this file.
{
  "type": "venue",
  "name": "IEEE S&P",
  // The call quoted above.
  "url": "https://sp2027.ieee-security.org/cfpapers.html",
  "extends": "paperlint:ieee-conference",

  // «Papers must be submitted in a form suitable for anonymous review» (the call above), and
  // `"blind":true` in the status data of both cycles' portals
  // (https://cycle1.sp2027.ieee-security.org/deadlines and
  // https://cycle2.sp2027.ieee-security.org/deadlines, read 2026-11-19). anonymity/identity then
  // requires the paper's `identity`.
  "blind": true,

  // The second cycle's HotCRP site, named in the call (the note above). Recorded 2026-11-19:
  // `/api/whoami` on this site answers 401 «Missing credentials» without a token — the HotCRP API,
  // there.
  "portal": {
    "kind": "hotcrp",
    "url": "https://cycle2.sp2027.ieee-security.org",
  },

  // The second cycle. The portal's readings, from its public deadlines page, read 2026-11-19:
  //   «Registration deadline: Wednesday Nov 11, 2026, 7:59:59 AM EST» (`"reg":1794401999`,
  //    2026-11-11T12:59:59Z)
  //   «Submission deadline: Wednesday Nov 18, 2026, 6:59:59 AM EST» (`"sub":1795003199`,
  //    2026-11-18T11:59:59Z)
  // The call's, «All deadlines are 23:59:59 AoE (UTC-12)»:
  //   «Abstract registration deadline: November 10, 2026» → 2026-11-11T11:59:59Z
  //   «Paper submission deadline: November 17, 2026»      → 2026-11-18T11:59:59Z
  //   «Acceptance notification: March 5, 2027»            → 2027-03-06T11:59:59Z
  //   «Camera-ready deadline: April 8, 2027»              → 2027-04-09T11:59:59Z
  // 🔴 THE REGISTRATION READINGS DISAGREE BY ONE HOUR: the portal closes registration at
  // 12:59:59 UTC, an hour after the end of the call's AoE day. Both are kept; the earlier, the
  // call's, binds. The submission readings agree.
  "deadlines": [
    {
      "what": "registration",
      "at": "2026-11-11T12:59:59Z",
      "source": "portal",
      "url": "https://cycle2.sp2027.ieee-security.org/deadlines",
      "read": "2026-11-19",
    },
    {
      "what": "registration",
      "at": "2026-11-11T11:59:59Z",
      "source": "call",
      "url": "https://sp2027.ieee-security.org/cfpapers.html",
      "read": "2026-11-19",
    },
    {
      "what": "submission",
      "at": "2026-11-18T11:59:59Z",
      "source": "portal",
      "url": "https://cycle2.sp2027.ieee-security.org/deadlines",
      "read": "2026-11-19",
    },
    {
      "what": "submission",
      "at": "2026-11-18T11:59:59Z",
      "source": "call",
      "url": "https://sp2027.ieee-security.org/cfpapers.html",
      "read": "2026-11-19",
    },
    {
      "what": "notification",
      "at": "2027-03-06T11:59:59Z",
      "source": "call",
      "url": "https://sp2027.ieee-security.org/cfpapers.html",
      "read": "2026-11-19",
    },
    {
      "what": "camera-ready",
      "at": "2027-04-09T11:59:59Z",
      "source": "call",
      "url": "https://sp2027.ieee-security.org/cfpapers.html",
      "read": "2026-11-19",
    },
  ],

  // What the venue is called in a paper's text (tex/venue-leftover) — and only beside a year
  // («S&P 2027», «Oakland'27»): security papers name S&P as the venue of the work they cite, and
  // «S&P» is also the stock index, «Oakland» a city. «Oakland» is the call's own «Since 1980 in
  // Oakland». The bare «SP» (IEEE Xplore's acronym for the proceedings) is left out: as a folder
  // word (paper/folder-venue-leftover matches words, case ignored) it would take any «sp».
  "aliases": ["S&P", "Oakland"],
  "mentions": "with-year",

  // The class line the call names (tex/template).
  "template": "\\documentclass[conference,compsoc]{IEEEtran}",

  "format": {
    // \textwidth and \textheight of [conference,compsoc], measured (ieee-conference.jsonc).
    "textblock_w_in": 7.0,
    "textblock_h_in": 9.02,

    // 🔴 THE 13 PAGES ARE THE TEXT BEFORE THE REFERENCES AND THE APPENDICES: «up to 13 pages of text
    // and up to 5 pages for references and appendices» and «All text and figures past page 13 must
    // be clearly marked as part of the appendix.» So format/page-limit counts the body up to where
    // the references or the appendix start, whichever comes first (`body_ends_at`), not by banal's
    // count, which calls any page with non-bibliography text body (aidc.jsonc measures how an
    // appendix then pushes a correct paper over). Load hyperref: without it an appendix before the
    // references is counted as body (docs/rules/format/page-limit.md).
    "body_ends_at": "references",

    "kinds": {
      // «up to 13 pages of text and up to 5 pages for references and appendices, totaling no more
      // than 18 pages». Under `body_ends_at`, `ref_pages_max` is judged on banal's count of
      // reference pages (src/venue-rules.ts, judgePages: the text replaces only the body's count),
      // as for AISec's «references and appendices» (aisec.jsonc); the total, pdf.js's page count,
      // is gated too. Not measured on an S&P build.
      "research": { "body_pages_max": 13, "ref_pages_max": 5, "pages_max": 18 },
      // «For SoK papers, the references do not count towards the number of pages.» So neither the
      // references nor a total is limited. The appendices' own share (5 pages, if the 18 still
      // holds without the references) is not something the call states, and the preset cannot
      // count appendix pages apart from reference pages: not encoded (sp.md, «Not verified»).
      "sok": { "body_pages_max": 13, "ref_pages_max": "unlimited" },
    },
  },
}
