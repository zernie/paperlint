// ACL's LaTeX template — the TEMPLATE FAMILY of the *ACL conferences (ACL, EMNLP, NAACL, EACL and
// their workshops): what ACL's style files decide, whatever the venue. A venue preset extends it
// ("extends": "paperlint:acl-latex") and adds what its call for papers sets. Its card: `acl.md` beside
// this file.
//
// Only what the style files state is here: the class line and the TeX packages acl.sty loads. The
// page geometry, the font sizes and the fonts a PDF shows were measured on ONE build, a REALM 2026
// paper, so they stay in realm-2026.jsonc until a second ACL paper confirms them: a family's
// numbers bind every venue that extends it.
{
  "type": "family",

  // ACL's template is not a class: `acl_latex.tex` opens with `\documentclass[11pt]{article}` and
  // loads `acl.sty` as a package (https://github.com/acl-org/acl-style-files, checked 2026-09-27).
  // So the class `tex/template` compares against is article, at 11pt.
  "template": "\\documentclass[11pt]{article}",

  // The style the template loads into that class, so plain article without it does not pass
  // tex/template. No option: `acl_latex.tex` loads `\usepackage[review]{acl}` for review and says
  // «For the final version, omit the review option: \usepackage{acl}» (with «preprint» a third
  // form; checked 2026-11-26), so an option named here would fail every camera-ready (#556).
  "template_style": "\\usepackage{acl}",

  // TeX Live packages the ACL template needs ON TOP OF tex-base.jsonc (the shape is
  // venue-profile.schema.json). acl.sty itself travels with the paper; these are what it loads.
  //   times · helvetic · courier · symbol · zapfding — without them "Font ptmr8t not loadable" and
  //     no PDF at all. The proof is a font metric file, because that is what failed.
  //   `urw-base35` once stood in this list and was INVENTED: tlmgr answers "package urw-base35 not
  //     present in repository". The five names above are enough.
  "tex": {
    "packages": {
      "lineno": ["lineno.sty"],
      "psnfss": ["times.sty"],
      "times": ["ptmr8t.tfm"],
      "helvetic": ["phvr8t.tfm"],
      "courier": ["pcrr8t.tfm"],
      "symbol": ["psyr.tfm"],
      "zapfding": ["uzdr.tfm"],
    },
  },
}
