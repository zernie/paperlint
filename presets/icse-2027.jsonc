// and submission instructions», AGENTVERIFY «IEEE format in line with ICSE 2027», AGENT «the IEEE
// conference proceedings template».
{
  "type": "venue",
  // The series, without a year: the year is the id's (icse-2027), the one source of it.
  "name": "ICSE",
  // The research track's call quoted above.
  "url": "https://conf.researchr.org/track/icse-2027/icse-2027-research-track",
  "extends": "paperlint:ieee-conference",
