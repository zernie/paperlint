// AgenticDev (an ASE workshop) — a VENUE preset over the ACM sigconf family. Prose about the venue
// is in its card, agenticdev.md beside this file (every preset has one: `npm run lint` fails
// without it, and the card's rules section is generated from this file). Everything the ACM template decides (page size, columns, fonts, font
// sizes, TeX packages) comes from acm-sigconf.jsonc; this file adds what AgenticDev's call for
// papers sets.
// Source for the numbers: the Conference Publishing author instructions 2026-08-25.
{
  "type": "venue",
  "name": "AgenticDev",
  // The workshop's call for papers on the ASE 2026 site.
  "url": "https://conf.researchr.org/home/ase-2026/agenticdev-2026",
  "extends": "paperlint:acm-sigconf",

  // What the venue is called in a paper's text (tex/venue-leftover). Its parent conference, ASE,
  // is left out: a three-letter acronym that many sentences use for other things.
  "aliases": ["AgenticDev"],

  "format": {
    // The limits are a property of the paper's TYPE at this venue, not of the venue itself.
    // A given paper's type is stated in its <paper-dir>/paperlint.json (`kind`).
    "kinds": {
      "short": {
        "body_pages_max": 5,
        // «up to 2 extra pages of references»
        "ref_pages_max": 2,
      },
      "full": {
        // «Full ≤10pp (mature)»
        "body_pages_max": 10,
        "ref_pages_max": 2,
      },
      "demo": {
        "body_pages_max": 5,
        "ref_pages_max": 2,
      },
    },
  },

  // The talk (talk/* rules), for a paper whose paperlint.json declares `talk`. The numbers are the
  // organizers', each with its source; one_slide is left out on purpose — the venue never stated a
  // size, so a paper that wants its own checked declares it in its own `talk` key.
  "talk": {
    // AgenticDev adopted ASE's «not in person presentation» policy (co-chairs, 2026-08-27).
    "modes": ["remote-video"],
    "artifacts": {
      // The chairs' email to accepted authors: a video and a one-slide; a poster is optional.
      "remote-video": {
        "required": ["video", "one-slide"],
        "optional": ["poster"],
      },
    },
    "kinds": {
      // The chairs' email to all authors (2026-09-29): a short paper gets 10 min, about 6–7 for the
      // talk and 3–4 for questions.
      // qa_s is the middle of 3–4 min; it is informational and not judged. The full-paper slot
      // was not in the email, so `full` and `demo` have no entry and talk/profile says so.
      "short": {
        "slot_s": 600,
        "talk_s_min": 360,
        "talk_s_max": 420,
        "qa_s": 210,
      },
    },
    // ASE 2026's not-in-person page: «recommendation: 10 min duration, mp4 file format, HD
    // resolution» — the parent conference's recommendation; the workshop's own slot is above.
    "video": { "container": "mp4", "min_height_px": 720 },
  },

  // The proceedings are produced by Conference Publishing Consulting — agenticdev.md takes its
  // numbers from their author instructions — which require "balanced columns on the last page, if
  // the page is not filled", checked before the proceedings are produced: "problem papers are sent
  // back to the authors". So every AgenticDev paper gets the optional rule; a paper can still turn
  // it off in its own paperlint.json. 120 pt is the rule's default, measured: a balanced build ended
  // 2.7 pt apart, an unbalanced one 321.4 pt apart (docs/optional-rules.md).
  //
  // The same vendor asks for headline style in the title and in every heading. Its help page
  // (https://www.conference-publishing.com/Help.php) defines it: «Headline-Style Capitalization
  // (according to the Chicago Manual of Style, Sections 8.157, 8.158, and 8.159)», with the word
  // lists the rule's chicago-headline style judges by. Its instructions for an event
  // (https://www.conference-publishing.com/Instructions.php?Event=ITICSE18) set both scopes:
  // «The title should use headline-style capitalization (e.g., 'The Best POPL Paper of All Time')»
  // and «All levels of headings use headline-style capitalization.» Its checklist names it, and
  // papers that miss it are returned to their authors. The rule lives here and not in acm-sigconf: ACM's own
  // pages and the other vendors that produce ACM proceedings were not read, and an error on a
  // requirement nobody has seen would block correct papers. A venue whose author kit names the
  // same authority adds the same line; one that names another (APA, IEEE, Springer) waits for that
  // style (docs/rules/tex/heading-case.md, «Adding a style»).
  "rules": {
    "pdf/last-page-balance": ["error", { "tolerancePt": 120 }],
    "tex/heading-case": [
      "error",
      { "title": "chicago-headline", "headings": "chicago-headline" },
    ],
  },
}
