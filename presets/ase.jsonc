// ASE 2026 Research Papers (the 41st IEEE/ACM International Conference on Automated Software
// Engineering, the main conference's research track; its AgenticDev workshop is agenticdev.jsonc)
// — a VENUE preset over the ACM sigconf family. Everything the acmart template decides (page size,
// columns, fonts, font sizes, TeX packages) comes from acm-sigconf.jsonc; this file adds what ASE's
// call for papers sets.
//
// THE 2026 EDITION, WHOSE DEADLINES HAVE PASSED: on 2026-11-19 the ASE 2027 research track page
// says «The full call for papers will be published soon.» and gives preliminary dates only
// (https://conf.researchr.org/track/ase-2027/ase-2027-research-track; they are in the card,
// ase.md). The 2026 call is the most recent one published.
//
// Verbatim from https://conf.researchr.org/track/ase-2026/ase-2026-research-track (read 2026-11-19
// with curl; WebFetch's summary of the same page did not reach the call, which sits after the
// accepted-papers list):
//   «Template: \documentclass[sigconf,review,anonymous]{acmart}» and «Page limit: 10 pages (excl.
//    references) + 2 pages (only references).» (the call's tl;dr)
//   «All submissions must be in PDF format and conform, at time of submission, to the ACM
//    Proceedings Template … LaTeX users must use the \documentclass[sigconf,review,anonymous]{acmart}
//    option.»
//   «Submissions must not exceed 10 pages for the main text, including all figures, tables,
//    appendices, etc. Up to two additional pages containing ONLY references are permitted.
//    Submissions that do not adhere to these limits or that violate the formatting guidelines will
//    be desk-rejected without review.»
//   «The ASE 2026 Research Track will employ a double-anonymous review process.»
//   «Mandatory Data Availability Statement: to be placed in the paper submission after Conclusions
//    and within the 10-page limit.»
//
// THE DEADLINES ARE THE PORTAL'S, as read: `deadlines` below is rewritten by the scheduled refresh
// in paperlint's repository (.github/workflows/deadlines.yml) when the portal changes them. The
// call's own date table is in the card.
{
  "type": "venue",
  "name": "ASE",
  // The call quoted above.
  "url": "https://conf.researchr.org/track/ase-2026/ase-2026-research-track",
  "extends": "paperlint:acm-sigconf",

  // «The ASE 2026 Research Track will employ a double-anonymous review process. Thus, no submission
  // may reveal its authors' identities.» (the call above), and `"blind":true` in the portal's data
  // (https://ase26.hotcrp.com/deadlines, read 2026-11-19). anonymity/identity then requires the
  // paper's `identity`.
  "blind": true,

  // «Abstracts and papers must be submitted electronically through the ASE 2026 HotCRP submission
  // site: https://ase26.hotcrp.com/» (the call above). Recorded 2026-11-19: `/api/whoami` on this
  // site answers 401 "Missing credentials" without a token — the HotCRP API, there.
  "portal": { "kind": "hotcrp", "url": "https://ase26.hotcrp.com" },

  // Read from the portal's public deadlines page, 2026-11-19, all listed as past:
  //   «Submission deadline: Thursday Mar 26, 2026, 11:59:59 PM AoE — Submissions must be completed
  //    by this deadline to be reviewed.» (`data-ts="1774612799"`, `"sub":1774612799`)
  //   «Resubmission deadline: Monday Mar 30, 2026, 11:59:59 PM AoE — Completed submissions may be
  //    updated until this deadline.» (`data-ts="1774958399"`)
  // The same page's «revision resubmission deadline: Thursday Jul 16, 2026, 11:59:59 PM AoE»
  // (major revisions only) has no kind here: `resubmission` is the one above. The camera-ready is
  // the call's «Mon 3 Aug 2026 Camera-Ready Papers (all papers)», AoE (UTC-12h); the portal does
  // not show it.
  "deadlines": [
    {
      "what": "submission",
      "at": "2026-03-27T11:59:59Z",
      "source": "portal",
      "url": "https://ase26.hotcrp.com/deadlines",
      "read": "2026-11-19",
    },
    {
      "what": "resubmission",
      "at": "2026-03-31T11:59:59Z",
      "source": "portal",
      "url": "https://ase26.hotcrp.com/deadlines",
      "read": "2026-11-19",
    },
    {
      "what": "camera-ready",
      "at": "2026-08-04T11:59:59Z",
      "source": "call",
      "url": "https://conf.researchr.org/track/ase-2026/ase-2026-research-track",
      "read": "2026-11-19",
    },
  ],

  // What the venue is called in a paper's text (tex/venue-leftover) — and only beside a year
  // («ASE 2026», «ASE'26»): «ASE» is a three-letter acronym that sentences use for other things,
  // which is why agenticdev.jsonc leaves it out of its own names.
  "aliases": ["ASE"],
  "mentions": "with-year",

  // NO `template` HERE, on purpose: the call's class line is
  // `\documentclass[sigconf,review,anonymous]{acmart}`, and the camera-ready instructions of the
  // same edition ask for `\documentclass[sigconf,screen]{acmart}`
  // (https://www.conference-publishing.com/Instructions.php?Event=ASE26, read 2026-11-19).
  // tex/template does not know the paper's stage, so requiring `review` and `anonymous` would turn
  // a correct camera-ready red. The family's `[sigconf]` is required at both stages; the
  // anonymity of a submission is anonymity/identity's, through `blind` above.

  // «Mandatory Data Availability Statement: to be placed in the paper submission after Conclusions
  // and within the 10-page limit.» (the call above). The edition's policies page
  // (https://conf.researchr.org/track/ase-2026/ase-2026-submission-instructions-and-policies, read
  // 2026-11-19) names the section: «a dedicated section named “Data Availability Statement”», and
  // for the camera-ready «a section titled “Data Availability Statement” as the final section
  // before the bibliography». So the title exactly, after the last section of the body.
  "required_sections": [
    { "title": "Data Availability Statement", "position": "last" },
  ],

  "format": {
    // «Submissions must not exceed 10 pages for the main text, including all figures, tables,
    // appendices, etc. Up to two additional pages containing ONLY references are permitted.» (the
    // call above). The Data Availability Statement is inside the ten («within the 10-page limit»).
    // banal's default count is this limit: a page that holds any text that is not bibliography is a
    // body page — an appendix or the statement, before or after the references — and the reference
    // pages are the ones with only bibliography on them. So no `body_ends_at`, as in
    // agenticdev.jsonc, which has the same template and the same «10 + 2 only references» shape.
    //
    // Two kinds, in the call's words: «Technical Research Papers» and «Experience Papers», with the
    // same limit. «Accepted papers will be permitted an additional page of content … 11 pages
    // (including all figures, tables, appendices) plus 2 pages containing only references» is the
    // camera-ready's, not this limit.
    "kinds": {
      "technical": { "body_pages_max": 10, "ref_pages_max": 2 },
      "experience": { "body_pages_max": 10, "ref_pages_max": 2 },
    },
  },

  // The proceedings are produced by Conference Publishing Consulting: the edition's not-in-person
  // page sends authors to «the submission page for your paper (see author-kit e-mail from Conference
  // Publishing Consulting)» (https://conf.researchr.org/track/ase-2026/ase-2026-not-in-person-presentations,
  // read 2026-11-19), and that vendor's camera-ready instructions for this event
  // (https://www.conference-publishing.com/Instructions.php?Event=ASE26, «41st IEEE/ACM International
  // Conference on Automated Software Engineering (ASE 2026)», read 2026-11-19) require:
  //   «has balanced columns on the last page, if the page is not filled,»
  //   «The title should use headline-style capitalization (e.g., "The Best POPL Paper of All Time").»
  //   «All levels of headings use headline-style capitalization.»
  // The same two rules agenticdev.jsonc sets for the same vendor, with the same options: 120 pt is
  // pdf/last-page-balance's measured default (docs/optional-rules.md), and chicago-headline is the
  // vendor's own definition of headline style (https://www.conference-publishing.com/Help.php,
  // quoted in agenticdev.jsonc). A paper can turn either off in its own paperlint.json.
  "rules": {
    "pdf/last-page-balance": ["error", { "tolerancePt": 120 }],
    "tex/heading-case": [
      "error",
      { "title": "chicago-headline", "headings": "chicago-headline" },
    ],
  },
}
