// MSR 2027 Technical Papers (the 24th International Conference on Mining Software Repositories) — a
// VENUE preset over the IEEE conference family. Everything the IEEEtran template decides (page
// size, columns, fonts, body size, TeX packages) comes from ieee-conference.jsonc; this file adds
// what MSR's call for papers sets.
//
// Verbatim from https://2027.msrconf.org/track/msr-2027-technical-papers (fetched 2026-10-05):
//   «All submissions must conform to the IEEE conference proceedings template, specified in the
//    IEEE Conference Proceedings Formatting Guidelines (title in 24pt font and full text in 10pt
//    type, LaTeX users must use \documentclass[10pt,conference]{IEEEtran} without including the
//    compsoc or compsocconf options).»
//   «Note that IEEE format is being used this year, whereas last year it was ACM format.»
//   «All submissions must not exceed 10 pages for the main text, inclusive of all figures, tables,
//    appendices, etc. Two more pages containing only references are permitted. All submissions
//    must be in PDF. Accepted papers will be allowed one extra page for the main text of the
//    camera-ready version.»
//   «The MSR 2027 Technical Track will employ a double-anonymous review process.»
//
// THE DEADLINES ARE THE PORTAL'S, as read: `deadlines` below is rewritten by the scheduled refresh
// in paperlint's repository (.github/workflows/deadlines.yml) when the portal changes them, and a
// paper reaches the new dates through its normal update of paperlint. The call's own wording
// (abstract and paper days, AoE) is in the card, msr.md beside this file.
{
  "type": "venue",
  "name": "MSR",
  // The call quoted above.
  "url": "https://2027.msrconf.org/track/msr-2027-technical-papers",
  "extends": "paperlint:ieee-conference",

  // «The MSR 2027 Technical Track will employ a double-anonymous review process. Thus, no
  // submission may reveal its authors' identities.» (the call above), and `"blind":true` in the
  // portal's data (https://msr2027.hotcrp.com/deadlines, 2026-10-05). anonymity/identity then
  // requires the paper's `identity`.
  "blind": true,

  // «Papers must be submitted through HotCRP: https://msr2027.hotcrp.com/» (the call above).
  // Recorded 2026-10-05: `/api/whoami` on this site answers 401 "Missing credentials" without a
  // token — the HotCRP API, there.
  "portal": { "kind": "hotcrp", "url": "https://msr2027.hotcrp.com" },

  // Read from the portal's public deadlines page (no account) by the adapter in src/adapters/hotcrp/.
  // «Submissions must be completed by this deadline» is the `submission`: on the CALL's abstract
  // day, 04:00 UTC — four days before the call's paper day. «Completed submissions may be updated
  // until this deadline» is the `resubmission`.
  "deadlines": [
    {
      "what": "submission",
      "at": "2026-10-20T04:00:00Z",
      "source": "portal",
      "url": "https://msr2027.hotcrp.com/deadlines",
      "read": "2026-10-05",
    },
    {
      "what": "resubmission",
      "at": "2026-10-23T04:00:00Z",
      "source": "portal",
      "url": "https://msr2027.hotcrp.com/deadlines",
      "read": "2026-10-05",
    },
  ],

  // What the venue is called in a paper's text (tex/venue-leftover) — and only beside a year
  // («MSR 2027», «MSR'27»): «MSR» is also Microsoft Research, and an acronym papers define for
  // themselves («Manual Speech Recognition (MSR)», in an accepted ACSAC paper of
  // fixtures/accepted-papers/, warned six times when any whole word counted).
  "aliases": ["MSR"],
  "mentions": "with-year",

  // The class line the call names, with the two options it forbids (tex/template). The family's
  // `[conference]` text block (7.14 x 9.30 in) is the one this line builds, so no `format` override.
  "template": "\\documentclass[10pt,conference]{IEEEtran}",
  "template_forbids": ["compsoc", "compsocconf"],

  "format": {
    // 🔴 THE MAIN TEXT INCLUDES THE APPENDICES, AND THE REFERENCE PAGES ARE THE ONES WITH ONLY
    // REFERENCES — not banal's count. Measured 2026-10-05 on IEEEtran [10pt,conference] builds:
    //   10 pages of main text, its appendix before the references, 2 reference-only pages
    //     → banal: body 9, references 3 (a page whose first heading reads «Appendix» is typed as
    //       bibliography) — a correct paper fails
    //   11 pages of main text, the appendix after the references
    //     → banal: body 10, references 2 (the appendix taken for more references) — an over-long
    //       paper passes
    // So format/page-limit counts from the text (`appendix_in_body`): the body is every page up to
    // the references, that page too when body text stands above the heading, plus every page from
    // an appendix that follows the references; the pages between are the reference pages
    // (docs/rules/format/page-limit.md). An appendix after the references is found by hyperref's
    // anchor: load hyperref.
    "body_ends_at": "references",
    "appendix_in_body": true,

    // One kind: the Technical Track's papers. The camera-ready's extra page is not this limit.
    "kinds": {
      "technical": { "body_pages_max": 10, "ref_pages_max": 2 },
    },
  },

  // OPTIONAL RULES this venue's data supports: pdf/venue-shape compares the built paper with the
  // accepted papers measured in `shape` below — a warning, never a gate (docs/rules/pdf/venue-shape.md).
  "rules": { "pdf/venue-shape": "warn" },

  // WHERE MSR'S ACCEPTED PAPERS ARE — read by the study-accepted-papers skill instead of searching
  // anew each run. Every URL answered 200 on 2026-10-11, except where `access` says otherwise.
  "accepted": {
    "list": "https://{year}.msrconf.org/track/msr-{year}-technical-papers",
    "dblp": {
      "key": "conf/msr",
      "url": "https://dblp.org/db/conf/msr/msr{year}.html",
    },
    // «Note that IEEE format is being used this year, whereas last year it was ACM format.» (the
    // 2027 call). The 2025 PDFs are IEEEtran: 25 of the 29 measured below carry IEEE's «Index Terms».
    "editions": [
      {
        "year": 2027,
        "template": "IEEEtran",
        "current_template": true,
        "source": "https://2027.msrconf.org/track/msr-2027-technical-papers",
      },
      {
        "year": 2026,
        "template": "acmart",
        "current_template": false,
        "source": "https://2027.msrconf.org/track/msr-2027-technical-papers",
      },
      {
        "year": 2025,
        "template": "IEEEtran",
        "current_template": true,
        "source": "the accepted papers' PDFs, measured 2026-10-11",
      },
    ],
    "strong": [
      {
        "kind": "distinguished-paper",
        "name": "ACM SIGSOFT Distinguished Paper Award (Technical Track)",
        "url": "https://www.msrconf.org/hall-of-fame/",
        "years": "2015–2025",
        "limits": "«Since 2016 there is no separate Best Paper award anymore.» The 2025 winners also carry a badge on the 2025 track page and are listed by SIGSOFT (https://www2.sigsoft.org/awards/distinguishedpaper/). For 2026 no list was published on the track page, the hall of fame or SIGSOFT's page as of 2026-10-11, and the 2024 track page carries no badges: an edition without a list leaves its winners hidden among the ordinary accepted papers.",
      },
      {
        "kind": "most-influential-paper",
        "name": "Most Influential Paper award",
        "url": "https://www.msrconf.org/hall-of-fame/",
        "limits": "Chosen about ten years after publication: what the community values in the long run (infrastructure, datasets, pitfalls of mining), not what a program committee rated highly that year.",
      },
      {
        "kind": "hall-of-fame",
        "name": "Foundational Contribution Award",
        "url": "https://www.msrconf.org/hall-of-fame/",
        "limits": "Honours a body of work or a person, not one paper's review.",
      },
      {
        "kind": "impact-award",
        "name": "FOSS Impact Paper Award",
        "url": "https://www.msrconf.org/hall-of-fame/",
        "limits": "A different jury and criterion — the paper's value to free and open-source software — and authors of accepted papers self-nominate.",
      },
      {
        "kind": "special-issue",
        "name": "Empirical Software Engineering (EMSE) special issue of selected papers",
        "url": "https://2027.msrconf.org/track/msr-2027-technical-papers",
        "limits": "The call promises it («A selection of the best papers will be invited…»); the list of invited papers was not found public for 2025.",
      },
    ],
    "access": [
      {
        "host": "dl.acm.org",
        "note": "answers 403 (a Cloudflare challenge) to automated requests, measured 2026-10-11: take the DOI from DBLP and the PDF from arXiv or the authors' page",
      },
      {
        "host": "ieeexplore.ieee.org",
        "note": "answers 418 to automated requests and the PDFs are paywalled, measured 2026-10-11",
      },
    ],
  },

  // THE SHAPE OF MSR'S ACCEPTED PAPERS, for pdf/venue-shape: written by scripts/measure-venue-shape.ts
  // (never by hand), from the open PDFs of the 2025 Technical Track — the last edition in the IEEE
  // template the 2027 call requires. Checked against an independent count (poppler's pdftotext and
  // regular expressions) on the same 29 PDFs: tables and references equal on all 29; figures equal
  // on 28, and the 29th has the five captions read here where pdftotext's text held four; abstracts
  // within 13 words, except one whose abstract pdftotext did not find. The 2025 papers awarded a
  // Distinguished Paper are among the rows: the band is "accepted", not "ordinary".
  "shape": {
    "source": "MSR 2025 Technical Papers: the accepted full papers (10 to 13 pages) with an open PDF — arXiv preprints and authors' copies, not the proceedings' version",
    "url": "https://2025.msrconf.org/track/msr-2025-technical-papers",
