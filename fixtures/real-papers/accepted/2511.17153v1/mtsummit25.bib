@inproceedings{zhang-etal-2023-machine,
    title = "Machine Translation with Large Language Models: Prompting, Few-shot Learning, and Fine-tuning with {QL}o{RA}",
    author = "Zhang, Xuan  and
      Rajabi, Navid  and
      Duh, Kevin  and
      Koehn, Philipp",
