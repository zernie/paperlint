	note = {arXiv:2310.00402 [cs]},
	keywords = {Computer Science - Databases, Computer Science - Information Retrieval},
	file = {arXiv.org Snapshot:/Users/jason/Zotero/storage/MG7D546Q/2310.html:text/html;Full Text PDF:/Users/jason/Zotero/storage/UMVYN8LA/Ni et al. - 2023 - DiskANN++ Efficient Page-based Search over Isomor.pdf:application/pdf},
