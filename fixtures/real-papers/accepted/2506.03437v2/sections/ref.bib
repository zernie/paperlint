	file = {arXiv.org Snapshot:/Users/jason/Zotero/storage/RGQWGYTQ/1711.html:text/html;Full Text PDF:/Users/jason/Zotero/storage/L3JZT9TN/Xu et al. - 2018 - Online Product Quantization.pdf:application/pdf},
