	file = {PDF:/Users/chandler/Zotero/storage/7CQZLUG8/Crago et al. - 2024 - WASP Exploiting GPU Pipeline Parallelism with Hardware-Accelerated Automatic Warp Specialization.pdf:application/pdf},
}


