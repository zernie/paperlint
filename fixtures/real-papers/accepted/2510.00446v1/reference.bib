@misc{wang2025understandinga,
  title = {Towards an {{Understanding}} of {{Context Utilization}} in {{Code Intelligence}}},
  author = {Wang, Yanlin and Duan, Kefeng and Zheng, Dewu and Shi, Ensheng and Zhang, Fengji and Wang, Yanli and Chen, Jiachi and Liu, Xilin and Ma, Yuchi and Zhang, Hongyu and Wang, Qianxiang and Zheng, Zibin},
