#!/bin/sh
# Answers like tlmgr install: each package is looked up in the repository's catalog.txt
# ("name file…", a "bin:NAME" item creates an executable). An unknown name gets tlmgr's own
# wording, which is what rpp parses. Every call is appended to tlmgr.log at the tree root.
bin=$(cd "$(dirname "$0")" && pwd)
tree=$(cd "$bin/../.." && pwd)
repo=""
while [ $# -gt 0 ]; do
  case "$1" in
    --repository) repo=$2; shift 2 ;;
    install) shift; break ;;
    *) shift ;;
  esac
done
echo "$repo $*" >> "$tree/tlmgr.log"
catalog="${repo#file://}/catalog.txt"
status=0
for p in "$@"; do
  line=$(grep "^$p " "$catalog" || true)
  if [ -z "$line" ]; then
    echo "tlmgr install: package $p not present in repository."
    status=1
    continue
  fi
  for item in ${line#* }; do
    case "$item" in
      bin:*) : > "$bin/${item#bin:}"; chmod +x "$bin/${item#bin:}" ;;
      *) echo "$item" >> "$tree/files.txt" ;;
    esac
  done
done
exit $status
