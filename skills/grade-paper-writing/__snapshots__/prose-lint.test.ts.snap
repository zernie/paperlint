// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`--flags-only: an over-long caption flags and exits 1 1`] = `
"✍️  prose-lint — paper.tex — 2 finding(s):
   figures/fig1.tex: caption sentence of 46 words (warn >40) — "Big. word0 word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12 word13 word14 word15 wor…"
   figures/fig1.tex: caption is 106 words (warn >100) — a caption this long is a section under a picture
   run prose-lint.mjs on the file without --flags-only for the sentences
"
`;

exports[`--headings on a paper.tex lists its section titles, in order 1`] = `
"
=== paper.tex — every heading, in order ===
  1. Introduction
  2. The measurement pitfall
  3. Method: a cost-aware, correctness-gated harness
  4. Results
  5. The advertised savings don't show up
  6. A ceiling for any output-trimming tool
  7. Discussion and threats to validity
  8. Related work
  9. Conclusion

Read these as a stranger who will read nothing else. Each should name a thing:
a linter, a configuration, a repository, a rule — not "answers", "kinds", "moves".

(thresholds and their sources are in THRESHOLDS at the top of this file)
"
`;

exports[`the report over a rendered page: page numbers, hyphenation and the references are dropped 1`] = `
"
=== page.txt — 13 words, 3 sentences ===
sentence lengths [3,6,4]  mean 4.3  sd 1.2  CV 0.29
ok   all metadiscourse/1000w  0   (Hyland RA baseline 64.9, warn >90)
     nominalisations/1000w    0
ok   "rather than"/instead-of/10,000w  0   (warn >25; not epanorthosis, no published baseline)
ok   sentences ending on a cross-ref/citation/hedge (wasted stress position): 0
ok   sentences whose main claim is a negation: 0%
     topic positions (whose story is this?): "a rendered page." | "it was hyphenated across a" | "next page text here."

(thresholds and their sources are in THRESHOLDS at the top of this file)
"
`;

