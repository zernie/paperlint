// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`--flags-only: an over-long caption flags and exits 1 1`] = `
"✍️  prose-lint — paper.md — 2 finding(s):
   figures/fig1.tex: caption sentence of 46 words (warn >40) — "Big. word0 word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12 word13 word14 word15 wor…"
   figures/fig1.tex: caption is 106 words (warn >100) — a caption this long is a section under a picture
   run \`node .claude/skills/grade-paper-writing/prose-lint.mjs <file>\` for the sentences
"
`;

exports[`--headings lists every heading from level 2 to 4, in order 1`] = `
"
=== paper.md — every heading, in order ===
  1. Introduction
  2. Method

Read these as a stranger who will read nothing else. Each should name a thing:
a linter, a configuration, a repository, a rule — not "answers", "kinds", "moves".

(thresholds and their sources are in THRESHOLDS at the top of this file)
"
`;

exports[`a .tex file is refused with exit 2, and nothing is measured 1`] = `
"prose-lint reads markdown, not LaTeX: <root>/paper.tex
There is no .tex stripping here — the word count would include the preamble and the .bib,
and every metric (they are all fractions of the word count) would be understated by roughly half.
What to cover prose in .tex with — papers/research/2026-08-26-proza-v-latex-zanyatost.md
"
`;

exports[`the full report over markdown and rendered text 1`] = `
