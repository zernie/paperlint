      "references": {
        "summary": "What the guideline says",
        "entries": [
          {
            "label": "Guideline",
            "title": "Security guide `SQL-1`",
            "fields": [
              { "text": "Build every query with parameters, never by joining strings." },
              {
                "label": "Why",
                "text": "A query built from strings lets input become part of the query, and a value a user typed can then change what the query does: read other rows, change data, or drop a table. Parameters keep data and query apart in every driver the shop uses."
              },
              { "style": "note", "text": "The examples below are the guide's own." },
              {
                "label": "Not like this",
                "style": "code",
                "text": "db.raw(\"SELECT * FROM t WHERE id=\" + id)"
              },
              {
                "label": "Like this",
                "style": "code",
                "text": "db.raw(\"SELECT * FROM t WHERE id=%s\", [id])"
              }
            ],
            "url": "https://example.com/guide#sql-1",
            "url_label": "Security guide"
          }
        ]
      },
      "more": {
        "summary": "3 more lines like this",
        "items": ["`app/export.py`", "`app/admin.py`"],
        "rest": "and 1 more"
      },
