// Профиль формата REALM @ EMNLP 2026 — семейство ACL, НЕ ACM. Проза — в `realm.md` рядом,
// общие правила семейства — в `paper-pipeline/references/acl-venue-rules.md`.
//
// 🔴 ЧИСЛА ГЕОМЕТРИИ ЗАМЕРЕНЫ, А НЕ СКОПИРОВАНЫ. Прогон banal по собственной сборке
// (`repro/build-submission.sh` → `build/acl_latex.pdf`, 2026-08-26):
//   A4 8.26 x 11.69 in (595 x 842 pt) · 2 колонки · кегль тела 11.3 · интерлиньяж 13.6 ·
//   кегль библиографии 10.3 · поля [72, 67, 66, 68] pt · 0 шрифтов Type 3
// С acmart (letter 8.5x11, кегль 9, Libertine) общего нет НИЧЕГО — копирование чисел из
// `agenticdev.jsonc` дало бы гейт, краснеющий на корректной статье.
{
  "template": "acl",

  "page_size": "a4",
  "page_w_in": 8.27,
  "page_h_in": 11.69,

  "columns": 2,

  // Объявленный ACL кегль — 11pt; banal меряет моду по рендеру и даёт 11.3.
  "body_pt": 11,
  "body_pt_tol": 0.5,

  // ⚠️ Диапазон выведен из ОДНОГО замера (10.3), а не из спецификации ACL — её числа по кеглю
  // библиографии я не нашёл. Поэтому взят широко: для правила уровня `error` ложное
  // срабатывание хуже пропуска. Сузить, когда найдётся первоисточник.
  "ref_pt_min": 9,
  "ref_pt_max": 11,

  // Times-клон из ACL-шаблона. Заголовки НЕ гейтим: в сборке присутствует и NimbusSanL-Bold,
  // но чем именно набран заголовок, замером `pdffonts` не установить — он говорит, что
  // начертание в файле ЕСТЬ, а не где оно применено.
  "fonts_text": "NimbusRomNo9L",

  // 🔴 ЛИМИТЫ СТРАНИЦ ЗДЕСЬ НЕ ГЕЙТЯТСЯ, И ЭТО ЗАМЕР, А НЕ ЛЕНЬ.
  //
  // banal классифицирует страницы по содержимому и относит Limitations и Ethics к ТЕЛУ.
  // ACL их из лимита исключает. Замер 26.08 на нашей же статье: banal сказал «body 13»,
  // собственный счётчик сборки — «body pages: 9», и правы оба, просто считают разное
  // (тело кончается Conclusion на стр. 9; стр. 10-13 — Limitations/Ethics; с 14 — библиография).
  //
  // Гейт на числе banal дал бы 13 против лимита 8 и покраснел бы на статье, которая в лимит
  // укладывается. Для правила уровня `error` это худший исход. Лимит остаётся за счётчиком
  // внутри `build-submission.sh`: он читает markdown-исходник и потому ЗНАЕТ, где кончается
  // тело, а PDF этого не знает.
  //
  // Числа ниже — ДАННЫЕ для того счётчика и для человека, не вход правила. Источник:
  // `realm.md`, выверено прямым фетчем CFP 2026-08-02/03.
  "page_limits_not_gated": {
    "_": "8 при подаче, 9 в camera-ready (+1 страница). Оба числа СЕЙЧАС зашиты в build-submission.sh — в шапке 8, в прогоне 9, и это читается как расхождение, хотя это разные СТАДИИ. Скрипту стоит брать их отсюда.",
    "long_submission": 8,
    "long_camera_ready": 9,
    "short_submission": 4,
    "short_camera_ready": 5,
    "refs_and_appendices": "unlimited",
    "limitations_and_ethics": "не считаются (правило ACL)"
  },

  "kinds": {
    "long": {},
    "short": {}
  }
}
