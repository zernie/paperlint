// Профиль формата площадки — ДАННЫЕ, которые читает правило `pdf/profile` в
// eslint-rules/pdf-facts.mjs. Проза про площадку — в agenticdev.md рядом.
// Источник чисел: инструкция для авторов Conference Publishing 2026-08-25 + требования ACM.
//
// 🔴 Почему JSONC, а не YAML (решение 26.08). Я держал это в YAML, объясняя тем, что
// «в JSON нет комментариев, а у каждого числа тут цитата из инструкции». Возражение оказалось
// ложным: @eslint/json везёт три языка — json, jsonc, json5, — и jsonc это ровно JSON с
// комментариями. Значит цитаты остаются на месте, файл читается настоящим парсером
// (@humanwhocodes/momoa, уже стоит транзитивно), И его линтует тот же движок, что и всё
// остальное. Одна лишняя зависимость (js-yaml на этом пути) отпадает.
{
  "template": "acmart",

  // 8.5 x 11 in
  "page_size": "letter",
  "page_w_in": 8.5,
  "page_h_in": 11.0,

  // «text width must not exceed 18 cm»
  "textblock_w_in": 7.087,
  // «text height must not exceed 23.5 cm»
  "textblock_h_in": 9.252,
  // ACM требует свести колонки последней страницы; 29.08 Conference Publishing вернул за это
  // принятую статью («Please correct the last page balancing»). Допуск с запасом: замеры того
  // дня дали 2.7 pt у сведённой версии и 321.4 у несведённой — между ними ничего не лежит.
  "last_page_balance_tol_pt": 120,

  "columns": 2,

  // «font size is 9 pt for all body text»
  "body_pt": 9,
  // banal меряет МОДУ по отрендеренному тексту, а не объявленный кегль (замер 26.08: 9.30 при
  // acmart-овских 9). Отсюда допуск — и отсюда же то, что кегль тела остаётся нуджем, а не гейтом.
  "body_pt_tol": 0.5,

  // «font size of the references can be from 7 pt to 9 pt»
  "ref_pt_min": 7,
  "ref_pt_max": 9,

  // «text must be in serif font (Libertine)»
  "fonts_text": "LinLibertine",
  // «The title must be in sans-serif font (Biolinum)»
  "fonts_title": "LinBiolinum",

  // Лимиты — свойство ТИПА статьи у этой площадки, а не самой площадки.
  // Какой тип у конкретной статьи, говорит её <paper-dir>/venue.json.
  "kinds": {
    "short": {
      "body_pages_max": 5,
      // «up to 2 extra pages of references»
      "ref_pages_max": 2
    },
    "full": {
      // «Full ≤10pp (mature)»
      "body_pages_max": 10,
      "ref_pages_max": 2
    },
    "demo": {
      "body_pages_max": 5,
      "ref_pages_max": 2
    }
  }
}
