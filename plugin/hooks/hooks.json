{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/node_modules/research-paper-pipeline/bin/rpp.mjs\" hook paper-edit-guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/node_modules/research-paper-pipeline/bin/rpp.mjs\" hook paper-skills-nudge"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/node_modules/research-paper-pipeline/bin/rpp.mjs\" hook paper-status-gates"
          }
        ]
      }
    ]
  }
}
