{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo/pkg.tsbuildinfo",
    "resolveJsonModule": true
  },
  "include": ["lib/*.ts", "eslint-rules/*.ts", "eslint-rules/*.json"],
  "exclude": ["**/*.test.ts", "**/*.harness.ts", "**/*.d.ts"]
}
