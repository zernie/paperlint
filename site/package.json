{
  "name": "paperlint-site",
  "private": true,
  "description": "paperlint.dev: a static Next.js export, its content read from the repository's README and docs at build time.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "lint": "steiger ./src --fail-on-warnings && eslint .",
    "test": "vitest run --coverage",
    "build": "next build",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "motion": "14.14.0",
    "next": "16.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remeda": "2.62.2",
    "ts-essentials": "10.2.1",
    "tw-animate-css": "1.4.0",
    "usehooks-ts": "3.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@feature-sliced/steiger-plugin": "0.8.2",
    "@next/eslint-plugin-next": "16.4.6",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-tailwindcss": "4.4.0",
    "playwright-core": "1.64.1",
    "shadcn": "4.23.0",
    "shiki": "4.6.0",
    "steiger": "0.10.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
