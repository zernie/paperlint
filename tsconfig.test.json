{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "customConditions": ["paperlint-source"]
  },
  "include": ["**/*.ts", "**/*.mts"],
  "files": [".github/CLAUDE.md.spec.ts", "plugin/CLAUDE.md.spec.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "plugin",
    "**/.tmp*",
    "docs/prior-art/repro"
  ]
}
