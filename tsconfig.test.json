{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "customConditions": ["paperlint-source"]
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "lib/**/*.test.ts",
    "hooks/**/*.test.ts",
    "bin/**/*.test.ts",
    "skills/**/*.test.ts",
    "fixtures/**/*.ts",
    "skills/**/fixtures/**/*.ts",
    "hooks/**/*.harness.ts",
    "skills/**/*.harness.ts"
  ],
  "exclude": []
}
