{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "skills",
    "outDir": "skills",
    "declarationDir": "dist/skills",
    "declarationMap": false,
    "sourceMap": false,
    "tsBuildInfoFile": "dist/.tsbuildinfo/skills.tsbuildinfo"
  },
  "include": ["skills/*/scripts/*.ts"],
  "exclude": ["**/*.test.ts", "**/*.harness.ts", "**/*.d.ts"]
}
